msgstr "окупаемости"

msgid "Порахуй, як курс працюватиме на дохід"
msgstr "Посчитайте, как курс будет работать на доход"

msgid "Середній чек процедури, ₴"
msgstr "Средний чек процедуры, ₴"

msgid "вартість курсу"
msgstr "стоимость курса"

msgid ""
"Розрахунок орієнтовний. Фактичний результат залежить від попиту, прайсу, "
"витрат на матеріали й завантаженості практики."
msgstr ""
"Расчет ориентировочный. Фактический результат зависит от спроса, прайса, "
"затрат на материалы и загруженности практики."

msgid "Після навчання"
msgstr "После обучения"

msgid "Що залишається"
msgstr "Что остается"

msgid "з лікарем"
msgstr "с врачом"

msgid "Медичний контекст без зайвих обіцянок"
msgstr "Медицинский контекст без лишних обещаний"

msgid "Протокол і практична навичка"
msgstr "Протокол и практический навык"

msgid "Зрозуміла логіка роботи та техніка, відпрацьована під наглядом тренера."
msgstr "Понятная логика работы и техника, отработанная под наблюдением тренера."

msgid "Навчальні матеріали"
msgstr "Учебные материалы"

msgid "Опора для повторення та підготовки до перших процедур."
msgstr "Опора для повторения и подготовки к первым процедурам."

msgid "Підтвердження освіти"
msgstr "Подтверждение образования"

msgid "Сертифікат і бали БПР у програмах, де це передбачено."
msgstr "Сертификат и баллы БПР в программах, где это предусмотрено."

msgid "Підтримка ментора"
msgstr "Поддержка ментора"

msgid ""
"Післяосвітній супровід для впевненого старту та розбору практичних "
"запитань."
msgstr ""
"Сопровождение после обучения для уверенного старта и разбора практических"
" вопросов."

msgid "Карта професійного зростання"
msgstr "Карта профессионального роста"

msgid "Від базового курсу"
msgstr "От базового курса"

msgid "до власної клініки"
msgstr "до собственной клиники"

msgid ""
"Почніть із бази та рухайтеся до складніших протоколів, системного "
"впровадження плазмотерапії й управління власним медичним напрямом."
msgstr ""
"Начните с базы и двигайтесь к более сложным протоколам, системному "
"внедрению плазмотерапии и управлению собственным медицинским "
"направлением."

msgid "Рівень 1"
msgstr "Уровень 1"

msgid "Базовий курс із плазмотерапії"
msgstr "Базовый курс по плазмотерапии"

msgid ""
"Біологія аутоплазми, PRP, PRF, PPP, показання та безпечний алгоритм "
"роботи."
msgstr ""
"Биология аутоплазмы, PRP, PRF, PPP, показания и безопасный алгоритм "
"работы."

msgid "Фундамент методики"
msgstr "Фундамент методики"

msgid "Рівень 2"
msgstr "Уровень 2"

msgid "Спеціалізація за напрямом"
msgstr "Специализация по направлению"

msgid ""
"Профільні протоколи для дерматології, гінекології, стоматології, "
"ортопедії та інших спеціальностей."
msgstr ""
"Профильные протоколы для дерматологии, гинекологии, стоматологии, "
"ортопедии и других специальностей."

msgid "Клінічна спеціалізація"
msgstr "Клиническая специализация"

msgid "Рівень 3"
msgstr "Уровень 3"

msgid "Впровадження у практику"
msgstr "Внедрение в практику"

msgid ""
"Складніші кейси, документи, сервіс, післяосвітня підтримка та стабільна "
"робота з новою послугою."
msgstr ""
"Более сложные кейсы, документы, сервис, поддержка после обучения и "
"стабильная работа с новой услугой."

msgid "Системна практика"
msgstr "Системная практика"

msgid "Рівень 4"
msgstr "Уровень 4"

msgid "Власник клініки"
msgstr "Владелец клиники"

msgid ""
"Команда, стандарти протоколів, розширення напрямів і масштабування "
"регенеративної медицини."
msgstr ""
"Команда, стандарты протоколов, расширение направлений и масштабирование "
"регенеративной медицины."

msgid "Управління й розвиток"
msgstr "Управление и развитие"

msgid "Переглянути курси маршруту"
msgstr "Посмотреть курсы маршрута"

msgid "Після"
msgstr "После"

msgid "навчання"
msgstr "обучения"

msgid "Досвід фахівців після практики"
msgstr "Опыт специалистов после практики"

msgid "Оцінка 5 з 5"
msgstr "Оценка 5 из 5"

msgid ""
"Після практики стало зрозуміло, як запускати процедуру без хаосу: "
"протокол, матеріали, собівартість і комунікація з пацієнтом."
msgstr ""
"После практики стало понятно, как запускать процедуру без хаоса: "
"протокол, материалы, себестоимость и коммуникация с пациентом."

msgid "Олена · Київ · лікарка-косметологиня"
msgstr "Елена · Киев · врач-косметолог"

msgid ""
"Найцінніше — клінічна логіка й спокійний супровід тренера. Усе без зайвих"
" обіцянок."
msgstr ""
"Самое ценное — клиническая логика и спокойное сопровождение тренера. Все "
"без лишних обещаний."

msgid "Марина · Львів · власниця кабінету"
msgstr "Марина · Львов · владелица кабинета"

msgid "Система навчання"
msgstr "Система обучения"

msgid "Від біології плазми"
msgstr "От биологии плазмы"

msgid "до впевненого протоколу"
msgstr "до уверенного протокола"

msgid "Розуміння"
msgstr "Понимание"

msgid "Механізми дії, фракції плазми, показання та межі методики."
msgstr "Механизмы действия, фракции плазмы, показания и границы методики."

msgid "Рішення"
msgstr "Решение"

msgid "Вибір пацієнта, планування та логіка клінічного протоколу."
msgstr "Выбор пациента, планирование и логика клинического протокола."

msgid "Підготовка матеріалу, техніка й відпрацювання під контролем тренера."
msgstr "Подготовка материала, техника и отработка под контролем тренера."

msgid "Впровадження й підтримка"
msgstr "Внедрение и поддержка"

msgid ""
"Документація, інтеграція послуги у практику та супровід ментора після "
"навчання."
msgstr ""
"Документация, интеграция услуги в практику и сопровождение ментора после "
"обучения."

msgid "Для команд і клінік"
msgstr "Для команд и клиник"

msgid ""
"Навчи команду — підсиль практику. Знижка для груп від трьох фахівців, "
"формат під напрям клініки, салону чи кабінету."
msgstr ""
"Обучите команду — усильте практику. Скидка для групп от трех "
"специалистов, формат под направление клиники, салона или кабинета."

msgid "Перед вибором"
msgstr "Перед выбором"

msgid "Коротко про"
msgstr "Коротко о"

msgid "важливе"
msgstr "важном"

msgid "Чи потрібен досвід роботи з плазмотерапією?"
msgstr "Нужен ли опыт работы с плазмотерапией?"

msgid ""
"Ні для всіх програм. У каталозі є базові й тематичні курси; вимоги до "
"освіти та досвіду зазначені на сторінці кожної програми."
msgstr ""
"Не для всех программ. В каталоге есть базовые и тематические курсы; "
"требования к образованию и опыту указаны на странице каждой программы."

msgid "Чи є практична частина?"
msgstr "Есть ли практическая часть?"

msgid ""
"Формат залежить від програми. Практичні курси включають демонстрацію, "
"роботу з матеріалом або відпрацювання під керівництвом тренера."
msgstr ""
"Формат зависит от программы. Практические курсы включают демонстрацию, "
"работу с материалом или отработку под руководством тренера."

msgid "Як нараховуються бали БПР?"
msgstr "Как начисляются баллы БПР?"

msgid ""
"Кількість балів і умови їх отримання вказані на сторінці конкретного "
"сертифікованого заходу."
msgstr ""
"Количество баллов и условия их получения указаны на странице конкретного "
"сертифицированного мероприятия."

msgid "Як обрати програму під свою спеціальність?"
msgstr "Как выбрать программу под свою специальность?"

msgid ""
"Відкрийте каталог і скористайтеся фільтром за спеціальністю або "
"зверніться до команди ІПРМ за консультацією."
msgstr ""
"Откройте каталог и воспользуйтесь фильтром по специальности или "
"обратитесь к команде ИПРМ за консультацией."

msgid "Наступний професійний крок"
msgstr "Следующий профессиональный шаг"

msgid "Оберіть програму, яку зможете"
msgstr "Выберите программу, которую сможете"

msgid "застосувати у практиці"
msgstr "применить на практике"

msgid ""
"Розкажіть про освіту, спеціальність і бажаний напрям — підберемо маршрут "
"без тиску та випадкових програм."
msgstr ""
"Расскажите об образовании, специальности и желаемом направлении — "
"подберем маршрут без давления и случайных программ."

msgid "Отримати консультацію"
msgstr "Получить консультацию"

msgid ""
"Курси після дипломної освіти з плазмотерапії для лікарів. Лабораторії "
"біологічного віку, клініка регенеративних технологій. Офіційне "
"нарахування балів БПР."
msgstr ""
"Курсы последипломного образования по плазмотерапии для врачей. "
"Лаборатории биологического возраста, клиника регенеративных технологий. "
"Официальное начисление баллов БПР."

msgid "Бали БПР — Сертифіковані курси"
msgstr "Баллы БПР — Сертифицированные курсы"

msgid "Плазмотерапія."
msgstr "Плазмотерапия."

msgid "Регенерація."
msgstr "Регенерация."

msgid ""
"Курси після дипломної освіти для лікарів, дослідження біологічного віку "
"та персоналізована регенеративна терапія"
msgstr ""
"Курсы последипломного образования для врачей, исследования биологического"
" возраста и персонализированная регенеративная терапия"

msgid "Про лабораторії"
msgstr "О лабораториях"

msgid "плазмотерапії та регенеративної медицини"
msgstr "плазмотерапии и регенеративной медицины"

msgid ""
"Навчальні курси інституту плазмотерапії проводяться висококваліфікованими"
" спеціалістами з багатим досвідом у сфері регенеративної медицини, "
"плазмотерапії та біорегуляційної медицини."
msgstr ""
"Учебные курсы института плазмотерапии проводятся высококвалифицированными"
" специалистами с богатым опытом в сфере регенеративной медицины, "
"плазмотерапии и биорегуляционной медицины."

msgid "Сучасна інформація"
msgstr "Современная информация"

msgid ""
"Слухачі курсів отримують максимум сучасної інформації по вибраних темах "
"регенеративної медицини."
msgstr ""
"Слушатели курсов получают максимум современной информации по выбранным "
"темам регенеративной медицины."

msgid ""
"Після проходження вибраного курсу слухачі отримують сертифікати з балами "
"БПР (безперервний професійний розвиток), що підтверджують підвищення "
"кваліфікації."
msgstr ""
"После прохождения выбранного курса слушатели получают сертификаты с "
"баллами БПР (непрерывное профессиональное развитие), подтверждающие "
"повышение квалификации."

msgid "Сертифікат з балами БПР"
msgstr "Сертификат с баллами БПР"

msgid "Інститут у"
msgstr "Институт в"

msgid "цифрах"
msgstr "цифрах"

msgid "Рік заснування"
msgstr "Год основания"

msgid "Років досліджень"
msgstr "Лет исследований"

msgid "Лабораторії та клініка"
msgstr "Лаборатории и клиника"

msgid "Курсів проведено"
msgstr "Курсов проведено"

msgid "Курси після дипломної освіти"
msgstr "Курсы последипломного образования"

msgid "Наші"
msgstr "Наши"

msgid "лабораторії"
msgstr "лаборатории"

msgid "Наукові дослідження та інновації у сфері регенеративної медицини"
msgstr "Научные исследования и инновации в сфере регенеративной медицины"

msgid "Лабораторія біологічного віку"
msgstr "Лаборатория биологического возраста"

msgid "Лабораторія біологічного віку та прогнозування захворювань"
msgstr "Лаборатория биологического возраста и прогнозирования заболеваний"

msgid ""
"Вимірювання та модифікація біологічного віку, виявлення індивідуальних "
"ризиків захворювань та персоналізовані стратегії профілактики"
msgstr ""
"Измерение и модификация биологического возраста, выявление индивидуальных"
" рисков заболеваний и персонализированные стратегии профилактики"

msgid "Персоналізована терапія"
msgstr "Персонализированная терапия"

msgid "Визначення індивідуальних параметрів для вибору персоналізованої терапії"
msgstr ""
"Определение индивидуальных параметров для выбора персонализированной "
"терапии"

msgid "Біоінформатика та ШІ"
msgstr "Биоинформатика и ИИ"

msgid "Інтегральний аналіз даних досліджень з використанням штучного інтелекту"
msgstr ""
"Интегральный анализ данных исследований с использованием искусственного "
"интеллекта"

msgid "Біомаркери старіння"
msgstr "Биомаркеры старения"

msgid "Пошук, апробація, валідація нових біомаркерів старіння та геропротекторів"
msgstr "Поиск, апробация, валидация новых биомаркеров старения и геропротекторов"

msgid "Anti-age протоколи"
msgstr "Anti-age протоколы"

msgid ""
"Дослідження ефективності нових anti-age протоколів та процесів старіння "
"на клітинному рівні"
msgstr ""
"Исследование эффективности новых anti-age протоколов и процессов старения"
" на клеточном уровне"

msgid "Клітинне старіння"
msgstr "Клеточное старение"

msgid ""
"Дослідження процесів старіння на клітинному рівні з використанням "
"сучасних методів"
msgstr ""
"Исследование процессов старения на клеточном уровне с использованием "
"современных методов"

msgid "Лабораторія біологічного віку та"
msgstr "Лаборатория биологического возраста и"

msgid "прогнозування захворювань"
msgstr "прогнозирования заболеваний"

msgid ""
"Вимірювати та модифікувати біологічний вік, своєчасно виявляти "
"індивідуальні ризики захворювань і пропонувати персоналізовані стратегії "
"профілактики"
msgstr ""
"Измерять и модифицировать биологический возраст, своевременно выявлять "
"индивидуальные риски заболеваний и предлагать персонализированные "
"стратегии профилактики"

msgid "Ключові задачі"
msgstr "Ключевые задачи"

msgid "Розрахунок біологічного віку"
msgstr "Расчет биологического возраста"

msgid "Епігенетичні \"годинники\" (DNAm)"
msgstr "Эпигенетические \"часы\" (DNAm)"

msgid "Прогнозування ризиків на основі багатофакторних даних"
msgstr "Прогнозирование рисков на основе многофакторных данных"

msgid "Моніторинг інтервенцій та оцінка ефектів"
msgstr "Мониторинг интервенций и оценка эффектов"

msgid "Створення індивідуальних \"паспортів довголіття\""
msgstr "Создание индивидуальных \"паспортов долголетия\""

msgid "Методики та сервіс"
msgstr "Методики и сервис"

msgid "Комплексна діагностика"
msgstr "Комплексная диагностика"

msgid "Епігенетичні тести та інтерпретація результатів"
msgstr "Эпигенетические тесты и интерпретация результатов"

msgid "Розширені панелі крові: ліпідний профіль, запальні та оксидативні маркери"
msgstr ""
"Расширенные панели крови: липидный профиль, воспалительные и оксидативные"
" маркеры"

msgid "HRV-моніторинг, аналіз сну та активності"
msgstr "HRV-мониторинг, анализ сна и активности"

msgid "Консиліум із фахівцями клініки регенеративних технологій"
msgstr "Консилиум со специалистами клиники регенеративных технологий"

msgid "Як це змінює якість життя"
msgstr "Как это меняет качество жизни"

msgid ""
"Раннє виявлення відхилень, зниження ймовірності метаболічних, "
"серцево-судинних і нейродегенеративних подій, кращий контроль енергії, "
"сну й відновлення, підвищення резистентності до стресу, збереження "
"працездатності."
msgstr ""
"Раннее выявление отклонений, снижение вероятности метаболических, "
"сердечно-сосудистых и нейродегенеративных событий, лучший контроль "
"энергии, сна и восстановления, повышение резистентности к стрессу, "
"сохранение работоспособности."

