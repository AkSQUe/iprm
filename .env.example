SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///iprm.db
FLASK_CONFIG=development

# LiqPay
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

# reCAPTCHA v3 -- DB-first (керується в /admin/recaptcha), env -- fallback.
# Site key вшивається в HTML, secret key валідує токен на бекенді.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5

# Meta Pixel -- DB-first (керується в /admin/meta-pixel), env -- fallback.
# ID публічний (вшивається в HTML). Потрібні ОБИДВІ змінні: сам ID трекінг
# не вмикає.
META_PIXEL_ENABLED=false
META_PIXEL_ID=

# Mail -- SMTP settings are stored in DB, configured via /admin/notifications
