# Keys and secrets
keys/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# Flask
instance/
*.db
*.sqlite3
migrations/versions/*.pyc

# i18n: генерований POT-шаблон і скомпільовані каталоги (компілюються
# при деплої: pybabel compile у deploy.yml). У git -- лише .po.
app/translations/messages.pot
app/translations/**/*.mo

# Generated certificate PDFs (private, persisted on server, not in repo).
# Leading slash anchors to repo root so app/templates/certificates/ -- where
# the Jinja template lives -- is NOT ignored.
/certificates/

# Database backups (created by backup service, persisted on server)
/backups/

# Media uploads (persisted on server via nginx alias)
/media/

# Environment
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node (Tailwind build)
node_modules/

# Згенеровані UI-скріншоти (scripts/ui_screenshots.py)
_shots/
.preview/shots/
scripts/.cache/
.preview/

# Замiри швидкості (tools/perf/perf_check.py): результати прогонів локальні,
# бо залежать від каналу вимірювальної машини. У git -- лише сам інструмент.
tools/perf/runs/

# Знімки розмітки (tools/ds/html_snapshot.py): вивід прогону, а не код.
# Те саме правило, що й вище -- у git живе інструмент, не його результат.
tools/ds/snapshots/

# Робочі вивантаження в корені (списки реєстрацій, збережені сторінки).
# Лежать поруч із кодом, і `git add -A` тягне їх у коміт -- уже двічі мало
# не поїхали. Самі файли лишаються на диску.
/*.md
!README.md
!CLAUDE.md
*.mhtml
docs/legal/*.docx

# Вихідники графіки й бекапи поруч зі згенерованими зображеннями: у продакшн
# їх не віддають, а важать вони мегабайти (.psd -- десятки).
*.psd
*.HEIC
*.heic
*_backup.webp

# Знімки обчислених стилів (tools/ds/computed_snapshot.py): вивід прогону.
tools/ds/computed/
